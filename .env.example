# Server Configuration
HOST=0.0.0.0
PORT=29870
APP_URL=http://localhost:29870
NODE_ENV=development

# Database (Default: SQLite local DB, supports PostgreSQL as well)
DATABASE_URL="file:./data/deploynest.db"

# Security & Secrets
JWT_SECRET=deploynest_jwt_secret_key_change_in_production_min32chars
ENCRYPTION_KEY=deploynest_32_bytes_super_secure_encryption_key!
GITHUB_WEBHOOK_SECRET=deploynest_default_webhook_secret_key

# Deployments root directory (Where apps get cloned and run)
DEPLOYMENT_ROOT=./data/deployments
