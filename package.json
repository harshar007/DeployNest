{
  "name": "deploynest",
  "version": "1.0.0",
  "description": "DeployNest - Centralized Self-Hosted CI/CD Hub",
  "type": "module",
  "scripts": {
    "dev": "vite --port 29870 --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --port 29870 --host 0.0.0.0",
    "backend:py": "python run_backend.py",
    "test:py": "python -m pytest tests/test_api_suite.py && python tests/test_lifecycle.py"
  },
  "keywords": [
    "cicd",
    "deployment",
    "github",
    "automation",
    "vps",
    "devops",
    "deploynest",
    "react"
  ],
  "author": "DeployNest Team",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
